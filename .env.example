# Postgres connection string (Supabase, Neon, or local).
DATABASE_URL=postgres://curbside:curbside@localhost:5432/curbside

# Public URL of the site, used to build sign-in links.
APP_URL=http://localhost:3000

# Sign-in emails are sent with Resend. Leave unset in development and the
# sign-in link is printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=CurbsideTO <login@example.com>

# Comma-separated emails that can hide comments.
ADMIN_EMAILS=
